{
  "name": "delta-codex",
  "version": "0.1.0",
  "description": "Native Codex collaboration through Delta threads and synchronized checkouts",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "delta-codex": "bin/delta-codex.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "hooks",
    "skills",
    ".codex-plugin",
    ".agents",
    "README.md",
    "PARITY.md",
    "NOTICE",
    "LICENSE",
    "docs",
    "scripts",
    "test",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm test && npm run build && npm run format:check",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "npm run build",
    "test:native": "node scripts/test-native.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}
